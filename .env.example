# Copy this file to .env and insert environment-specific values.
# Never store real secrets in this example file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Future CI-Machine server-to-server integration.
CI_MACHINE_API_BASE_URL=
CI_MACHINE_API_TOKEN=
